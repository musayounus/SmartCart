# Copy to .env for local runs outside Docker. Every value below is already the
# application default, so the file is optional -- it exists to document what is
# configurable, not to be required.
#
# docker compose sets these itself and ignores this file.

# Where Postgres lives. Matches the port docker compose publishes.
DATABASE_URL=postgresql+asyncpg://smartcart:smartcart@localhost:5432/smartcart

# Where the rate limiter counts checkouts.
#
# Leave this unset and the limit is counted in process memory, which is correct
# for exactly one instance: run two and each allows the full limit, so the
# effective limit doubles. Set it and the count is shared, which is what makes
# more than one task safe.
#
# Managed Redis usually requires TLS -- use rediss:// there.
REDIS_URL=redis://localhost:6379/0

# Checkouts allowed per client per window, and the window in seconds.
#
# The default sits well above what the concurrency tests burst on purpose. A
# limit tight enough to catch them would return 429s, and a 429 reads as a
# successful rejection to an oversell assertion -- the limiter would quietly
# mask the race rather than fail visibly. Set the limit to 0 to disable it.
CHECKOUT_RATE_LIMIT=60
CHECKOUT_RATE_WINDOW_SECONDS=60
