server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Upstream is templated because the two containers sit next to each
    # other differently in each environment: separate compose services
    # locally (api:8000), two containers in one ECS task sharing a network
    # namespace in AWS (127.0.0.1:8000).
    # The API sits behind the same origin, so the browser makes no
    # cross-origin requests and the app needs no CORS configuration.
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # The rate limiter keys on client IP, so the real one has to survive
        # the hop. Without this every shopper would look like the proxy.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Swagger UI is served at /api/docs, but the page it returns asks for
    # /openapi.json at the root -- an absolute path FastAPI generates without
    # knowing it sits behind a prefix. Without this exact-match location that
    # request falls through to the SPA below and Swagger is handed HTML, which
    # it cannot parse, so the page renders with no endpoints.
    #
    # Routing it here rather than setting FastAPI's root_path keeps the API
    # reachable unprefixed on its own port, where /docs also works.
    location = /openapi.json {
        proxy_pass http://${API_UPSTREAM}/openapi.json;
    }

    # Hashed asset filenames, so they can be held indefinitely.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html must never be cached. It names the hashed assets, so a stale
    # copy points a returning browser at filenames the new image no longer
    # contains -- it then runs the previous build from its own cache and looks
    # like a deploy that silently did nothing. With no Cache-Control at all,
    # browsers fall back to heuristic freshness and do exactly that.
    location = /index.html {
        expires -1;
        add_header Cache-Control "no-cache";
    }

    # Single-page app: unknown paths are routes, not missing files.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
